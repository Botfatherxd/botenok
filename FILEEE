# --- АДМИН-ФУНКЦИИ ---
def process_broadcast(message):
    if not is_admin(message.from_user.id):
        return
    
    # Рассылка сообщения всем пользователям
    sent = 0
    failed = 0
    
    bot.send_message(ADMIN_USERNAME, "📢 Начинаю рассылку...")
    
    for uid in users:
        try:
            # Копируем сообщение (текст, фото, видео и т.д.)
            bot.copy_message(
                chat_id=int(uid),
                from_chat_id=message.chat.id,
                message_id=message.message_id,
                reply_markup=types.InlineKeyboardMarkup().add(
                    types.InlineKeyboardButton("📢 " + CHANNEL_USERNAME, url=f"https://t.me/{CHANNEL_USERNAME.replace('@', '')}")
                )
            )
            sent += 1
            time.sleep(0.05)  # Защита от флуда
        except:
            failed += 1
    
    bot.send_message(
        ADMIN_USERNAME,
        f"✅ Рассылка завершена:\n"
        f"▫️ Отправлено: {sent}\n"
        f"▫️ Ошибок: {failed}",
        reply_markup=admin_menu()
    )

def process_give_user(message):
    if not is_admin(message.from_user.id):
        return
    
    try:
        target_id, amount = message.text.split()
        target_id = str(target_id)
        amount = int(amount)
        
        if target_id not in users:
            users[target_id] = {"attempts": 5, "premium_attempts": 0, "is_premium": False}
        
        users[target_id]["attempts"] += amount
        save_data(users)
        
        bot.send_message(ADMIN_USERNAME, f"✅ Выдано {amount} попыток пользователю {target_id}", reply_markup=admin_menu())
        
        # Уведомление пользователю (с подписью админа)
        try:
            bot.send_message(
                int(target_id),
                f"🎁 <b>Администратор @{message.from_user.username} выдал тебе {amount} попыток!</b>\n"
                f"Всего попыток: {users[target_id]['attempts'] + users[target_id]['premium_attempts']}",
                parse_mode="HTML"
            )
        except:
            pass
    except:
        bot.send_message(ADMIN_USERNAME, "❌ Неверный формат. Пример: 123456789 10", reply_markup=admin_menu())

def process_give_all(message):
    if not is_admin(message.from_user.id):
        return
    
    try:
        amount = int(message.text)
        
        for uid in users:
            if uid not in users:
                continue
            users[uid]["attempts"] += amount
        
        save_data(users)
        
        bot.send_message(
            ADMIN_USERNAME,
            f"✅ Выдано {amount} попыток ВСЕМ пользователям ({len(users)} чел.)",
            reply_markup=admin_menu()
        )
    except:
        bot.send_message(ADMIN_USERNAME, "❌ Введи число", reply_markup=admin_menu())

def process_premium_user(message):
    if not is_admin(message.from_user.id):
        return
    
    try:
        target_id = str(message.text.strip())
        
        if target_id not in users:
            users[target_id] = {"attempts": 5, "premium_attempts": 0, "is_premium": False}
        
        users[target_id]["is_premium"] = True
        users[target_id]["premium_attempts"] += 20
        users[target_id]["cooldown"] = 3
        save_data(users)
        
        bot.send_message(ADMIN_USERNAME, f"✅ Премиум выдан пользователю {target_id}", reply_markup=admin_menu())
        
        # Уведомление
        try:
            bot.send_message(
                int(target_id),
                f"🌹 <b>Администратор @{message.from_user.username} выдал тебе Премиум!</b>\n"
                "+20 премиум-попыток, КД 3 сек, доступ к Бета-тестам",
                parse_mode="HTML"
            )
        except:
            pass
    except:
        bot.send_message(ADMIN_USERNAME, "❌ Неверный ID", reply_markup=admin_menu())

def process_premium_random(message):
    if not is_admin(message.from_user.id):
        return
    
    try:
        count = int(message.text)
        all_users = list(users.keys())
        
        if count > len(all_users):
            count = len(all_users)
        
        winners = random.sample(all_users, count)
        
        for uid in winners:
            users[uid]["is_premium"] = True
            users[uid]["premium_attempts"] += 20
            users[uid]["cooldown"] = 3
            
            # Уведомление победителям
            try:
                bot.send_message(
                    int(uid),
                    f"🎉 <b>Ты выиграл Премиум в случайном розыгрыше!</b>\n"
                    f"🌹 +20 премиум-попыток, КД 3 сек!\n\n"
                    f"Розыгрыш провёл: @{message.from_user.username}",
                    parse_mode="HTML"
                )
            except:
                pass
        
        save_data(users)
        
        bot.send_message(
            ADMIN_USERNAME,
            f"🎲 Премиум выдан {count} рандомным пользователям!\n"
            f"Победители: {', '.join(winners)}",
            reply_markup=admin_menu()
        )
    except:
        bot.send_message(ADMIN_USERNAME, "❌ Введи число", reply_markup=admin_menu())

def show_stats(call):
    if not is_admin(call.from_user.id):
        return
    
    total = len(users)
    premium = sum(1 for u in users.values() if u.get("is_premium"))
    
    stats = (
        f"📊 <b>Статистика RozaSearch</b>\n\n"
        f"👥 Всего пользователей: {total}\n"
        f"🌹 Премиум: {premium}\n"
        f"👤 Обычных: {total - premium}\n\n"
        f"💎 Куплено Премиумов: {premium}\n"
    )
    
    markup = types.InlineKeyboardMarkup()
    markup.add(types.InlineKeyboardButton("🔄 Обновить", callback_data="admin_stats"))
    markup.add(types.InlineKeyboardButton("⬅️ Админ-панель", callback_data="admin_back"))
    
    bot.edit_message_text(stats, call.message.chat.id, call.message.message_id, parse_mode="HTML", reply_markup=markup)

