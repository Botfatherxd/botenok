# --- ФУНКЦИИ ПРОВЕРКИ ЮЗЕРНЕЙМОВ ---
def check_username_tg(username: str) -> bool:
    """
    Проверка через Telegram API (аккаунты).
    True = СВОБОДЕН, False = ЗАНЯТ
    """
    try:
        # Метод через проверку существования чата
        url = f"https://t.me/{username}"
        headers = {
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
        }
        response = requests.get(url, headers=headers, timeout=10, allow_redirects=True)
        
        # Если редиректит на страницу "не найден" или нет meta-тегов профиля
        if "tgme_page_title" not in response.text:
            return True
        # Дополнительная проверка по фразе "If you have Telegram"
        if "If you have Telegram, you can contact" in response.text:
            return True
        return False
    except:
        return None

def check_username_fragment(username: str) -> bool:
    """
    Проверка через Fragment API (аукционы/номера).
    True = СВОБОДЕН (нет на аукционе), False = ЗАНЯТ
    """
    try:
        url = f"https://fragment.com/username/{username}"
        headers = {
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
            "Accept": "text/html,application/xhtml+xml"
        }
        response = requests.get(url, headers=headers, timeout=10)
        
        # Проверяем наличие таблицы с лотами (если есть таблица - юз в аукционе/продан)
        if "table" in response.text and ("auction" in response.text.lower() or "sold" in response.text.lower()):
            # Дополнительно проверяем статус "Available" 
            if "Available" in response.text and "Not available" not in response.text:
                return True
            return False
        # Если нет таблицы и нет информации о продаже - свободен
        if "No results" in response.text or "not found" in response.text.lower():
            return True
        return True  # Считаем свободным если не нашли информацию о занятости
    except:
        return None

def generate_random_username(length: int, with_digits: bool) -> str:
    """Генерация случайного юзернейма заданной длины"""
    chars = string.ascii_lowercase
    if with_digits:
        chars += string.digits
    
    # Гарантируем что начинается с буквы (правила Telegram)
    first_char = random.choice(string.ascii_lowercase)
    rest = ''.join(random.choices(chars, k=length-1))
    return first_char + rest

