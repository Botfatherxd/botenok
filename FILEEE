# --- ФУНКЦИИ ПОИСКА ---
def perform_search(call, length, with_digits):
    user_id = str(call.from_user.id)
    
    # Проверка попыток
    if user_id not in users:
        bot.answer_callback_query(call.id, "Нажми /start", show_alert=True)
        return
    
    total_attempts = users[user_id]["attempts"] + users[user_id]["premium_attempts"]
    if total_attempts <= 0:
        bot.answer_callback_query(call.id, "❌ Нет попыток! Получи Премиум.", show_alert=True)
        return
    
    # Статус поиска
    bot.edit_message_text(
        f"🔍 <b>Ищем свободный юзернейм...</b>\n\n"
        f"📏 Длина: {length} символов\n"
        f"{'🔢' if with_digits else '🔤'} Тип: {'с цифрами' if with_digits else 'только буквы'}\n\n"
        f"⏳ Проверяю базы Telegram и Fragment...",
        call.message.chat.id,
        call.message.message_id,
        parse_mode="HTML"
    )
    
    # Списываем попытку
    if users[user_id]["premium_attempts"] > 0:
        users[user_id]["premium_attempts"] -= 1
    else:
        users[user_id]["attempts"] -= 1
    save_data(users)
    
    # Поиск (до 100 попыток найти свободный)
    found = False
    searched_usernames = []
    
    for _ in range(100):
        username = generate_random_username(length, with_digits)
        searched_usernames.append(username)
        
        # Проверяем
        tg_free = check_username_tg(username)
        frag_free = check_username_fragment(username)
        
        if tg_free and frag_free:
            found = True
            
            # Формируем результат
            result = (
                f"🎉 <b>Найден свободный юзернейм!</b>\n\n"
                f"✅ <code>@{username}</code>\n\n"
                f"📊 Результаты проверки:\n"
                f"▫️ Telegram: ✅ Свободен\n"
                f"▫️ Fragment: ✅ Нет в аукционах\n\n"
                f"⚡️ <b>100% свободен!</b> Забирай скорее!\n\n"
                f"🔗 <a href='https://t.me/{username}'>Открыть в Telegram</a>\n\n"
                f"📈 Осталось попыток:\n"
                f"▫️ Базовые: {users[user_id]['attempts']}\n"
                f"▫️ Премиум: {users[user_id]['premium_attempts']}"
            )
            
            # Клавиатура
            markup = types.InlineKeyboardMarkup()
            markup.add(types.InlineKeyboardButton("🔄 Искать ещё", callback_data=f"search_{length}"))
            markup.add(types.InlineKeyboardButton("📋 Главное меню", callback_data="back_main"))
            
            bot.edit_message_text(
                result,
                call.message.chat.id,
                call.message.message_id,
                parse_mode="HTML",
                reply_markup=markup,
                disable_web_page_preview=False
            )
            
            # Лог админу
            if found:
                bot.send_message(
                    ADMIN_USERNAME,
                    f"🔍 @{call.from_user.username or call.from_user.id} нашёл @{username}\n"
                    f"Длина: {length}, Цифры: {with_digits}",
                    disable_web_page_preview=True
                )
            
            save_data(users)
            return
    
    # Если не нашли (очень редко)
    markup = types.InlineKeyboardMarkup()
    markup.add(types.InlineKeyboardButton("🔄 Попробовать снова", callback_data=f"search_{length}"))
    markup.add(types.InlineKeyboardButton("📋 Меню", callback_data="back_main"))
    
    bot.edit_message_text(
        "😔 Не удалось найти свободный юзернейм за 100 попыток.\n"
        "Попробуй другую длину или тип.",
        call.message.chat.id,
        call.message.message_id,
        reply_markup=markup
    )

